@echo off
setlocal EnableExtensions EnableDelayedExpansion
rem ====================================================================
rem  NOLF2 Modernizer -> Contract J.A.C.K. port : build + install script
rem  Usage:  build.bat            (build, then install into the game)
rem          build.bat /nolayout  (skip the Layout.txt patching step)
rem          build.bat /nobuild   (only re-pack and install)
rem ====================================================================
cd /d "%~dp0"
set "HERE=%CD%"
for %%I in ("%HERE%\..") do set "GAME=%%~fI"
set "SRC=%HERE%\src"
set "LOG=%HERE%\build.log"
set "ERRLOG=%HERE%\build_errors.log"
set "DOLAYOUT=1"
set "DOBUILD=1"
:args
if "%~1"=="" goto argsdone
if /i "%~1"=="/nolayout" set "DOLAYOUT=0"
if /i "%~1"=="/nobuild" set "DOBUILD=0"
shift
goto args
:argsdone

echo.
echo === Modernizer for Contract J.A.C.K. ===
echo Game folder : %GAME%
echo Work folder : %HERE%
echo.
if not exist "%GAME%\ContractJack.exe" (
  echo [ERROR] ContractJack.exe was not found in %GAME%
  echo         This folder must be placed inside your Contract J.A.C.K. folder.
  goto :fail
)
echo %HERE%| findstr /c:" " >nul && (
  echo [ERROR] The path contains spaces. Move this folder to a path without spaces.
  goto :fail
)

rem ---- 1. unpack the source ------------------------------------------
if not exist "%SRC%\Game\TO2-Game.sln" (
  echo [1/6] Unpacking source...
  if not exist "%HERE%\src.zip" ( echo [ERROR] src.zip is missing. & goto :fail )
  if not exist "%SRC%" mkdir "%SRC%"
  tar -xf "%HERE%\src.zip" -C "%SRC%" 2>nul
  if not exist "%SRC%\Game\TO2-Game.sln" (
    powershell -NoProfile -Command "Expand-Archive -Force -LiteralPath '%HERE%\src.zip' -DestinationPath '%SRC%'"
  )
  if not exist "%SRC%\Game\TO2-Game.sln" ( echo [ERROR] Could not unpack src.zip & goto :fail )
) else (
  echo [1/6] Source already unpacked.
)

if "%DOBUILD%"=="0" goto :pack

rem ---- 2. find Visual Studio -----------------------------------------
echo [2/6] Looking for Visual Studio...
set "VSWHERE=%SystemDrive%\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" (
  echo [ERROR] vswhere.exe not found - Visual Studio does not seem to be installed.
  echo         Install Visual Studio 2019 or 2022 Community with the workload
  echo         "Desktop development with C++" and the component "C++ MFC for latest build tools ^(x86 and x64^)".
  goto :fail
)
set "VSPATH="
pushd "%VSWHERE%\.."
for /f "usebackq delims=" %%I in (`vswhere.exe -latest -products * -requires Microsoft.Component.MSBuild -property installationPath`) do set "VSPATH=%%I"
if "%VSPATH%"=="" (
  echo [ERROR] No Visual Studio with MSBuild was found.
  goto :fail
)
set "VSVER="
for /f "usebackq delims=" %%I in (`vswhere.exe -latest -products * -requires Microsoft.Component.MSBuild -property installationVersion`) do set "VSVER=%%I"
popd
for /f "delims=." %%A in ("%VSVER%") do set "VSMAJOR=%%A"
set "TOOLSET=v142"
if "%VSMAJOR%"=="17" set "TOOLSET=v143"
if "%VSMAJOR%"=="15" set "TOOLSET=v141"
if "%VSMAJOR%"=="18" set "TOOLSET=v145"
set "MSB=%VSPATH%\MSBuild\Current\Bin\MSBuild.exe"
if not exist "%MSB%" set "MSB=%VSPATH%\MSBuild\15.0\Bin\MSBuild.exe"
if exist "%MSB%" goto msbok
echo [ERROR] MSBuild.exe not found.
goto :fail
:msbok
echo         Found: %VSPATH%
echo         MSBuild: %MSB%
echo         Toolset: %TOOLSET%

rem ---- 3. build -------------------------------------------------------
echo [3/6] Building (this can take several minutes). Log: %LOG%
if exist "%LOG%" del "%LOG%"
if exist "%ERRLOG%" del "%ERRLOG%"
set "COMMON=/p:Configuration=Final /p:Platform=Win32 /p:SolutionDir=%SRC%\Game\ /p:PlatformToolset=%TOOLSET% /p:WindowsTargetPlatformVersion=10.0 /p:ForceImportBeforeCppTargets=%HERE%\static_crt.props /nologo /v:minimal /m"
set "FAILED=0"
for %%P in (Game\ClientRes\TO2\ClientRes.vcxproj Game\ClientFxDLL\ClientFxDLL.vcxproj Game\ClientShellDLL\TO2\ClientShellDLL.vcxproj) do (
  echo         Building %%P
  "%MSB%" "%SRC%\%%P" %COMMON% >> "%LOG%" 2>&1
  if errorlevel 1 ( echo         ^>^> FAILED: %%P & set "FAILED=1" )
)
findstr /c:" error " "%LOG%" > "%ERRLOG%" 2>nul

rem ---- 4. locate the outputs -------------------------------------------
echo [4/6] Looking for build output...
set "CSHELL=" & set "CRES=" & set "CFX="
for /f "delims=" %%F in ('dir /s /b "%SRC%\Game\built\Final\CShell.dll" 2^>nul') do set "CSHELL=%%F"
for /f "delims=" %%F in ('dir /s /b "%SRC%\Game\built\Final\CRes.dll" 2^>nul') do set "CRES=%%F"
for /f "delims=" %%F in ('dir /s /b "%SRC%\Game\built\Final\ClientFx.fxd" 2^>nul') do set "CFX=%%F"
echo         CShell.dll : %CSHELL%
echo         CRes.dll   : %CRES%
echo         ClientFx   : %CFX%
if "%CSHELL%"=="" (
  echo.
  echo [BUILD FAILED] CShell.dll was not produced.
  echo   Send me the file  %ERRLOG%  and  %LOG%  and I will fix the errors.
  goto :fail
)
if "%CRES%"=="" (
  echo.
  echo [BUILD FAILED] CRes.dll was not produced. See %ERRLOG%
  goto :fail
)

:pack
rem ---- 5. pack the mod --------------------------------------------------
echo [5/6] Packing Modernizer.rez
set "STAGE=%HERE%\stage"
if exist "%STAGE%" rmdir /s /q "%STAGE%"
mkdir "%STAGE%"
if "%DOBUILD%"=="0" (
  for /f "delims=" %%F in ('dir /s /b "%SRC%\Game\built\Final\CShell.dll" 2^>nul') do set "CSHELL=%%F"
  for /f "delims=" %%F in ('dir /s /b "%SRC%\Game\built\Final\CRes.dll" 2^>nul') do set "CRES=%%F"
  for /f "delims=" %%F in ('dir /s /b "%SRC%\Game\built\Final\ClientFx.fxd" 2^>nul') do set "CFX=%%F"
)
copy /y "%CSHELL%" "%STAGE%\CShell.dll" >nul
copy /y "%CRES%" "%STAGE%\CRes.dll" >nul
if not "%CFX%"=="" copy /y "%CFX%" "%STAGE%\ClientFx.fxd" >nul
xcopy /e /i /y "%SRC%\Assets\Mod\Interface" "%STAGE%\Interface" >nul
mkdir "%STAGE%\Attributes" 2>nul
copy /y "%SRC%\Assets\Mod\Attributes\Jukebox.txt" "%STAGE%\Attributes\Jukebox.txt" >nul

if "%DOLAYOUT%"=="1" call :layout

if exist "%HERE%\Modernizer.rez" del "%HERE%\Modernizer.rez"
"%SRC%\Tools\lithrez.exe" c "%HERE%\Modernizer.rez" "%STAGE%"
if not exist "%HERE%\Modernizer.rez" ( echo [ERROR] lithrez did not create Modernizer.rez & goto :fail )

rem ---- 6. install ---------------------------------------------------------
echo [6/6] Installing into %GAME%
if not exist "%GAME%\Custom\mods\Modernizer" mkdir "%GAME%\Custom\mods\Modernizer"
copy /y "%HERE%\Modernizer.rez" "%GAME%\Custom\mods\Modernizer\Modernizer.rez" >nul
copy /y "%SRC%\libs\SDL2-2.0.12\lib\x86\SDL2.dll" "%GAME%\SDL2.dll" >nul
echo.
echo DONE. Start Contract J.A.C.K., open the Mods menu and choose "Modernizer".
echo To uninstall: delete  Custom\mods\Modernizer  and  SDL2.dll  from the game folder.
echo If the game crashes, please send me  %GAME%\error.log  and  %GAME%\Game\*.log
endlocal
pause
exit /b 0

rem ---- helper: add the Modernizer screens to the game's Layout.txt ------------
:layout
echo         Preparing Layout.txt patch...
set "CACHE=%HERE%\cache"
if not exist "%CACHE%" mkdir "%CACHE%"
if not exist "%CACHE%\Layout.txt" (
  set "TMPX=%HERE%\_rez_extract"
  if exist "!TMPX!" rmdir /s /q "!TMPX!"
  mkdir "!TMPX!"
  for %%R in (Update_v1x1.rez Game.rez) do (
    if not exist "%CACHE%\Layout.txt" (
      if exist "%GAME%\%%R" (
        echo         Extracting %%R  ^(Game.rez is large, this takes a while the first time^)...
        "%SRC%\Tools\lithrez.exe" x "%GAME%\%%R" "!TMPX!\%%R" >nul 2>&1
        for /f "delims=" %%L in ('dir /s /b "!TMPX!\%%R\Layout.txt" 2^>nul') do (
          if not exist "%CACHE%\Layout.txt" copy /y "%%L" "%CACHE%\Layout.txt" >nul
        )
      )
    )
  )
  if exist "!TMPX!" rmdir /s /q "!TMPX!"
)
if not exist "%CACHE%\Layout.txt" (
  echo         [WARN] Could not get the game's Layout.txt - the Jukebox/Experimental screens will have no layout.
  exit /b 0
)
mkdir "%STAGE%\Attributes" 2>nul
powershell -NoProfile -ExecutionPolicy Bypass -File "%HERE%\patch_layout.ps1" -Cj "%CACHE%\Layout.txt" -Mod "%SRC%\Assets\Mod\Attributes\Layout.txt" -Out "%STAGE%\Attributes\Layout.txt"
if errorlevel 1 ( echo         [WARN] Layout patch failed; skipping it. & del /q "%STAGE%\Attributes\Layout.txt" 2>nul )
exit /b 0

:fail
echo.
echo Build/installation did not complete.
pause
exit /b 1
